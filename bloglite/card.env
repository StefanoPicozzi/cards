# Settings for the bloglite card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place bloglite.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for bloglite. The container port stays 3000.
BLOGLITE_PORT=3000

# Label used to build the bloglite hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Optional: your own domain for the blog, as a bare name such as blog.example.org.
# bloglite uses it in its WebFinger address. Leave it empty to use the Edgible hostname.
# BLOGLITE_DOMAIN=

# The owner's login. There is no sign-up page: this is the only account.
BLOGLITE_ADMIN_USER=admin

# Password of the owner. Generate with: openssl rand -base64 24
BLOGLITE_ADMIN_PASSWORD=
