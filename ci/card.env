# Settings for the ci card. Both places read this file: copy the same one to each machine.
# Edit it before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place forge: Gitea and its database.
# The name is the one `edgible device list` prints. The Compose files do not read it.
FORGE_DEVICE=

# The device for place runner: the machine that runs the CI jobs.
RUNNER_DEVICE=

# Host port for Gitea's web. The container port stays 3000.
GITEA_PORT=3003

# Host port for Git over SSH. A TCP app's port is from 20000 to 29999. The container port stays 22.
GITEA_SSH_PORT=22222

# Label used to build the gitea and gitea-ssh hostnames.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the web uses your own domain. Then its full URL, with https://.
GITEA_URL=

# Gitea database password. Generate with: openssl rand -hex 16
GITEA_DB_PASSWORD=

# Signs Gitea's cookies and tokens. Generate with: openssl rand -hex 32
GITEA_SECRET_KEY=

# The first admin's password, set by the admin step. Generate with: openssl rand -hex 16
GITEA_ADMIN_PASSWORD=

# The first admin's email address. Change it to yours.
GITEA_ADMIN_EMAIL=admin@example.com

# Shared by Gitea and the runner, so the runner registers itself. Generate with: openssl rand -hex 32
GITEA_RUNNER_TOKEN=

# The job labels the runner offers, as label:docker://image. Jobs with runs-on: ubuntu-latest use this image.
GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:22-bookworm-slim
