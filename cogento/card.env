# Settings for the cogento card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place cogento.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Cogento. The container port stays 80.
COGENTO_PORT=80

# Label used to build the cogento hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# Leave empty, unless the app uses your own domain. Then its full URL, with https://.
COGENTO_URL=

# Database password. Generate with: openssl rand -hex 16
COGENTO_DB_PASSWORD=

# Signs Cogento's sessions. Generate with: openssl rand -hex 32
COGENTO_SESSION_SECRET=

# Signs unsubscribe links. Generate with: openssl rand -hex 32
COGENTO_UNSUBSCRIBE_SECRET=

# Encrypts Stripe keys saved in Cogento. Must be a Fernet key. Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
COGENTO_STRIPE_KEY_ENCRYPTION_KEY=

# Logto, from the accounts card. Public values. Leave blank and Cogento keeps its email-code sign-in.
# The Logto app's redirect URI is https://cogento.<ORG_LABEL>.edgible.com/callback, or COGENTO_URL plus /callback.
COGENTO_LOGTO_ENDPOINT=
COGENTO_LOGTO_APP_ID=

# Optional. When set, the first start creates this shared superuser. A club is created later, in Cogento.
COGENTO_SUPERUSER_EMAIL=

# true: a stranger cannot create a club from the open site. false: anyone can.
COGENTO_ONBOARDING_BY_INVITE=true
