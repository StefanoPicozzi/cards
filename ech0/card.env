# Settings for the ech0 card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place ech0.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Ech0. The container port stays 6277.
ECH0_PORT=6277

# Label used to build the ech0 hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The owner made by prepare.sh before the site is published.
ECH0_ADMIN_USER=admin
ECH0_ADMIN_EMAIL=admin@example.com

# Password of the owner. Generate with: openssl rand -base64 24
ECH0_ADMIN_PASSWORD=

# Secret that signs Ech0's login tokens. Generate with: openssl rand -base64 32
ECH0_JWT_SECRET=
