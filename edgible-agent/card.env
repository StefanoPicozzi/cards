# Settings for the edgible-agent card.
# Edit this copy on the machine before you start the containers.

# Serving device for place agent. Everything runs on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the Gateway and its Control UI, on this machine's loopback only.
# The container port stays 18789.
OPENCLAW_PORT=18789


# The AI gateway in this pattern holds the provider keys; the agent asks it for a model by purpose,
# with a key of its own (made on the machine) and a budget. Bring one key or both: a model whose
# key is empty fails, and its fallback answers.
# Gemini, for fast (a free tier exists): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek, for fast's fallback and for smart: https://platform.deepseek.com/api_keys (with some credit).
DEEPSEEK_API_KEY=
# Anthropic, for deluxe (Claude): https://console.anthropic.com/settings/keys (pay as you go, billed
# apart from a Claude.ai plan, which cannot be used here).
ANTHROPIC_API_KEY=

# The agent's model, by purpose: fast (everyday), smart (harder, slower), deluxe (the best, dearest) or private (on this machine).
OPENCLAW_MODEL=fast
# The models behind each purpose, in LiteLLM's provider/model form.
LITELLM_FAST_MODEL=gemini/gemini-3.5-flash
LITELLM_FAST_FALLBACK_MODEL=deepseek/deepseek-chat
LITELLM_SMART_MODEL=deepseek/deepseek-reasoner
# deluxe: the best model, dearest by far; an app asks for it on purpose.
LITELLM_DELUXE_MODEL=anthropic/claude-opus-5-5
# private: a model on this machine, through Ollama, such as the ollama-mac card on the same Mac.
LITELLM_PRIVATE_MODEL=ollama/qwen2.5:7b
LITELLM_PRIVATE_URL=http://host.docker.internal:11434
# The agent's spending cap at the gateway, in dollars per period (30d, 7d, 1d).
LITELLM_APP_BUDGET=5
LITELLM_APP_BUDGET_PERIOD=30d

# The Edgible accounts that may use OpenClaw, by email, comma separated, such as you@example.com.
# Set, Edgible's sign-in is the only lock: no token to paste, and each browser is approved as it
# arrives. Empty, the Control UI asks for the Gateway token, and each browser waits for approval.
OPENCLAW_USERS=
# The agent's time zone, such as Australia/Sydney.
OPENCLAW_TZ=UTC

# 1 lets the agent deploy, move and remove apps through Edgible's tools: each change asks you
# first and is recorded. Leave 0 for tools that only read.
EDGIBLE_MCP_ALLOW_WRITE=0

# Optional, with writes: only these devices may change, by the names `edgible device list`
# prints, comma separated. Empty, any device of the organisation.
EDGIBLE_MCP_DEVICES=

# Label used to build the openclaw hostname.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the app uses your own domain. Then it is the app's full URL, with https://.
OPENCLAW_URL=
