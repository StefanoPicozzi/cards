# Settings for the edgible-connector card.
# Edit this copy on the machine before you start the containers.

# Serving device for place connector. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the connector's address (mcp-signin). The container port stays 8000.
MCP_SIGNIN_PORT=8020

# Host port for the sign-in page (mcp-signin-login). The container port stays 8001.
MCP_SIGNIN_LOGIN_PORT=8021

# The Edgible organisation whose members may sign in: the one the CLI is logged in to.
# Generate with: edgible whoami --json | jq -er .organization.id
EDGIBLE_ORGANIZATION_ID=

# Optional: only these people may sign in, by the email of their Edgible account,
# comma separated. Empty, any member of the organisation may.
MCP_SIGNIN_USERS=

# 1 lets the assistant deploy, move and remove apps: each change asks first and is recorded.
# Leave 0 for tools that only read.
EDGIBLE_MCP_ALLOW_WRITE=0

# Optional, with writes: only these devices may change, by the names `edgible device list` prints,
# comma separated. Empty, any device of the organisation.
EDGIBLE_MCP_DEVICES=

# Label used to build the mcp-signin and mcp-signin-login hostnames.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# Leave these two empty, unless the apps use your own domain.
# Then each is that app's full URL, with https://.
MCP_SIGNIN_URL=
MCP_SIGNIN_LOGIN_URL=
