# Settings for the edgible-mcp card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place edgible-mcp.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for edgible-mcp. The container port stays 8000.
EDGIBLE_MCP_PORT=8000

# 1 adds the tools that deploy, move and remove apps: each asks first and is recorded.
# Leave 0 for read-only tools.
EDGIBLE_MCP_ALLOW_WRITE=0

# Optional, with writes: only these devices may change, by the names `edgible device list` prints,
# comma separated. Empty, any device of the organization.
EDGIBLE_MCP_DEVICES=
