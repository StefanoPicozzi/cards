# Settings for the immich card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: immich-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place immich.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Immich. The container port stays 2283.
IMMICH_PORT=2283



# The first admin's email address, which is also the admin's login. Change it to yours.
IMMICH_ADMIN_EMAIL=admin@example.com
