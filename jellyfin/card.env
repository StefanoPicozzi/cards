# Settings for the jellyfin card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: jellyfin-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place jellyfin.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for Jellyfin. The container port stays 8096.
JELLYFIN_PORT=8096

# The folder that holds your films, shows and music, mounted read-only. An absolute path,
# outside this directory, because removing the card deletes this directory.
JELLYFIN_MEDIA_DIR=

# The first admin's login name, set by the admin step.
JELLYFIN_ADMIN_USER=admin

