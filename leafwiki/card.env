# Settings for the leafwiki card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: leafwiki-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place leafwiki.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for LeafWiki. The container port stays 8080.
LEAFWIKI_PORT=8080

# Label used to build the leafwiki hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The email of the admin LeafWiki makes at its first start. The admin's username is admin.
LEAFWIKI_ADMIN_EMAIL=admin@example.org

# Leave commented to run the version the card was tested with.
# LEAFWIKI_IMAGE=
