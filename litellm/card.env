# Settings for the litellm card.
# Edit this copy on the machine before you start the containers.
# The gateway's own passwords and keys are not here: litellm-secrets makes them on the machine (card.yml secrets:).
# Serving device for place litellm.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=
# Host port for the gateway: its admin and its API. The container port stays 4000.
LITELLM_PORT=4000
# Provider keys you bring, each optional: a model whose key is empty fails, and its fallback answers.
# Gemini, for fast's fallback (a free tier exists, but runs out quickly): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek, for fast and smart: https://platform.deepseek.com/api_keys (with some credit; cents a day).
DEEPSEEK_API_KEY=
# OpenRouter, for open: one key reaches hundreds of models: https://openrouter.ai/settings/keys (with some credit).
OPENROUTER_API_KEY=
# Anthropic, for best (Claude): https://console.anthropic.com/settings/keys (pay as you go, billed
# apart from a Claude.ai plan, which cannot be used here).
ANTHROPIC_API_KEY=
# The models behind each purpose, in LiteLLM's provider/model form. Apps ask for fast, smart or private.
LITELLM_FAST_MODEL=deepseek/deepseek-chat
LITELLM_FAST_FALLBACK_MODEL=gemini/gemini-3.5-flash
LITELLM_SMART_MODEL=deepseek/deepseek-reasoner
LITELLM_OPEN_MODEL=openrouter/z-ai/glm-5.3
# best: for when it really matters, dearest by far; an app asks for it on purpose.
LITELLM_BEST_MODEL=anthropic/claude-opus-5-5
# best's own cap, in dollars per period, across all apps: past it, best falls back to smart.
LITELLM_BEST_BUDGET=5
LITELLM_BEST_BUDGET_PERIOD=30d
# private: a model on your own machine, through Ollama, such as the ollama-osx card on the same Mac.
LITELLM_PRIVATE_MODEL=ollama/qwen2.5:7b
# private-smart: a larger model on this machine, for private work, where there is memory for it
# (ollama-osx's qwen3.5:27b wants about 20 GB).
LITELLM_PRIVATE_SMART_MODEL=ollama/qwen3.5:27b
# Where that Ollama answers: this machine's by default. For an Ollama on another machine that
# Edgible publishes, such as the ollama-osx card's app, set its address (https://ollama.<org label>.edgible.app)
# and make a key for the gateway with `edgible app api-keys create --app ollama --name gateway`.
LITELLM_PRIVATE_URL=http://host.docker.internal:11434
# The key for that published Ollama. Empty for an Ollama on this machine.
OLLAMA_API_KEY=
# Each app's spending cap, in dollars per period (30d, 7d, 1d).
LITELLM_APP_BUDGET=5
LITELLM_APP_BUDGET_PERIOD=30d
