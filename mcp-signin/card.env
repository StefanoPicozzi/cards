# Settings for the mcp-signin card.
# Edit this copy on the machine before you start the containers.

# Serving device for place mcp-signin. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the MCP and OAuth address. The container port stays 8000.
MCP_SIGNIN_PORT=8020

# Host port for the sign-in page. The container port stays 8001.
MCP_SIGNIN_LOGIN_PORT=8021

# The MCP server behind mcp-signin, as the container reaches it, ending in its MCP path.
# A service in the same Compose project, as in a pattern card: http://<service>:<port>/mcp
# A port on this machine, with Docker Desktop (macOS, Windows): http://host.docker.internal:<port>/mcp
# (On Linux that reaches only a port bound to the Docker bridge, not 127.0.0.1: use a pattern.)
# Keep that server unpublished: it is told who signed in, and must hear it only from here.
MCP_UPSTREAM_URL=

# The Edgible organisation whose members may sign in: the one the CLI is logged in to.
# Generate with: edgible whoami --json | jq -er .organization.id
EDGIBLE_ORGANIZATION_ID=

# Optional: only these people may sign in, by the email of their Edgible account,
# comma separated. Empty, any member of the organisation may.
MCP_SIGNIN_USERS=

# What the consent page calls the server, and what it lets the assistant do.
MCP_SIGNIN_NAME="this MCP server"
MCP_SIGNIN_PURPOSE=

# Label used to build the mcp-signin and mcp-signin-login hostnames.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# Leave these two empty, unless the apps use your own domain.
# Then each is that app's full URL, with https://.
MCP_SIGNIN_URL=
MCP_SIGNIN_LOGIN_URL=
