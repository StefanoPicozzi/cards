# Settings for the n8n card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place workhorse. Both apps run on this device.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Label used to build the editor and webhook hostnames.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave these three empty, unless n8n uses your own domain. Then the editor's hostname (no https://),
# the editor's full URL, and the webhook's full URL, each as the Compose file builds them from ORG_LABEL.
N8N_HOSTNAME=
N8N_URL=
N8N_WEBHOOK_URL=

# Host port. The container port stays 5678.
N8N_PORT=5678

# Database password. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 16
POSTGRES_NON_ROOT_PASSWORD=

# Generate with: openssl rand -hex 32
RUNNERS_AUTH_TOKEN=
