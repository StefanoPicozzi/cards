# ollama-mac: this machine's settings. See README.md.

# The serving device that runs Ollama, as `edgible device list` names it.
DEVICE=
# The part after the app name in your Edgible hostnames, such as example in ollama.example.edgible.app.
ORG_LABEL=

# The port Ollama listens on. Edgible publishes it.
OLLAMA_PORT=11434

# The address Ollama listens on. Keep 0.0.0.0 for the published app to work: Ollama refuses a
# request whose Host is not localhost when it listens on 127.0.0.1 only, and Edgible forwards the
# app's own hostname, so every call, key or not, would be refused with a 403. The cost is that
# anything on this Mac's network can reach Ollama without a key; use it on a network you trust,
# and never forward the port on your router. 127.0.0.1 keeps it private to this Mac, and only
# local clients work then.
OLLAMA_BIND=0.0.0.0

# Where Ollama keeps its models. Empty: models/ in this card's directory, removed with the card.
# To keep using the models an earlier Ollama downloaded, set ~/.ollama/models. uninstall.sh
# never deletes a folder outside this card's directory.
OLLAMA_MODELS=

# The name of the background service install.sh starts. Keep it unless you run two copies.
SERVICE=org.edgible.ollama-mac
