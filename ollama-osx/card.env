# ollama-osx: this machine's settings. See README.md.

# The serving device that runs Ollama, as `edgible device list` names it.
DEVICE=
# The part after the app name in your Edgible hostnames, such as example in ollama.example.edgible.app.
ORG_LABEL=

# The port Ollama listens on, on this Mac only (127.0.0.1). Nothing else on the network can reach it.
OLLAMA_LOCAL_PORT=11434

# The port of the proxy in front of Ollama, also on this Mac only. Edgible publishes this one, so a
# key can use a model but not pull or delete one. (Ollama refuses a request whose Host is not
# localhost, and Edgible forwards the app's own hostname, so it cannot be published directly.)
OLLAMA_PORT=21434

# Where Ollama keeps its models. Empty: models/ in this card's directory, removed with the card.
# To keep using the models an earlier Ollama downloaded, set ~/.ollama/models. uninstall.sh
# never deletes a folder outside this card's directory.
OLLAMA_MODELS=

# The name of the background service install.sh starts for Ollama; the proxy's is this with
# -proxy added. Keep it unless you run two copies.
SERVICE=org.edgible.ollama-osx
