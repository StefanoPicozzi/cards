# Settings for the openclaw card.
# Edit this copy on the machine before you start the containers.

# Serving device for place openclaw.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for the Gateway and its Control UI, on this machine's loopback only.
# The container port stays 18789.
OPENCLAW_PORT=18789

# The Gateway token: the Control UI asks for it once per browser, after Edgible's sign-in.
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Which model the agent uses: gemini, openai-compatible, or none (set it up later yourself).
OPENCLAW_MODEL_PROVIDER=gemini

# gemini: a Google AI Studio key (free tier at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# The model. For gemini, a Flash model: the free tier refuses Pro and preview models.
# For openai-compatible, the model's name at that address, such as llama3.1:8b.
OPENCLAW_MODEL=google/gemini-3.5-flash

# openai-compatible: the model's address, ending in /v1, and its key if it needs one.
# ollama-mac on this machine: http://host.docker.internal:11434/v1
OPENCLAW_MODEL_URL=
OPENCLAW_MODEL_KEY=

# The agent's time zone, such as Australia/Sydney.
OPENCLAW_TZ=UTC

# Label used to build the openclaw hostname.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# Leave empty, unless the app uses your own domain. Then it is the app's full URL, with https://.
OPENCLAW_URL=
