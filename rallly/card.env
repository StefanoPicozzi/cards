# Settings for the rallly card.
# Edit this copy on the machine before you start the containers.
# The card's passwords and keys are not here: rallly-secrets makes them on the machine (card.yml secrets:).
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place rallly.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Label used to build the rallly hostname.
# Letters, digits, and hyphens. This is the label in a hostname, not the organization id.
# It is the part after the app name in a hostname that `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Host port for Rallly. The container port stays 3000.
RALLLY_PORT=3000



# Emails that may sign in and create polls, comma separated, such as you@example.org,*@yourclub.org.
# Anyone with a poll's link can still vote, with no account.
RALLLY_ALLOWED_EMAILS=

# Mail server for the sign-in codes Rallly emails. Rallly needs one to let organizers sign in.
RALLLY_SMTP_HOST=
RALLLY_SMTP_PORT=587
RALLLY_SMTP_SECURE=false
RALLLY_SMTP_USER=
# The mail server's password, for RALLLY_SMTP_USER.
RALLLY_SMTP_PASSWORD=
# The address the mail comes from.
RALLLY_SMTP_FROM=noreply@example.com
