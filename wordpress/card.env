# Settings for the wordpress card.
# Edit this copy on the machine before you start the containers.
# The organization id is not a line here. It comes from the logged-in CLI.

# Serving device for place wordpress.
# The name is the one `edgible device list` prints. The Compose file does not read this.
DEVICE=

# Host port for WordPress. The container port stays 80.
WORDPRESS_PORT=8085

# Label used to build the wordpress hostname.
# It is the part after the app name in a hostname `edgible app list` prints.
ORG_LABEL=

# The domain Edgible gives new apps' hostnames: edgible.app since October 2026.
# An app published earlier keeps its edgible.com hostname: set edgible.com for it.
EDGIBLE_DOMAIN=edgible.app

# Leave empty, unless the site uses your own domain. Then its full URL, with https://.
WORDPRESS_URL=

# WordPress database password. Generate with: openssl rand -hex 16
WORDPRESS_DB_PASSWORD=

# The first admin's password, set by the Install step. Generate with: openssl rand -hex 16
WORDPRESS_ADMIN_PASSWORD=

# The first admin's email address. Change it to yours.
WORDPRESS_ADMIN_EMAIL=admin@example.com
